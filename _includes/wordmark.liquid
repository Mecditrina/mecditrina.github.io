{% comment %}
  Coloured wordmark, used in the navbar (header.liquid) and the home page hero.
  Text comes from `wordmark.first` / `wordmark.second` in _config.yml, so a rename only touches the config.
{% endcomment %}
<span class="mx-wordmark" role="img" aria-label="{{ site.wordmark.first }}{{ site.wordmark.second }}"
  ><span class="mx-mec">{{ site.wordmark.first }}</span><span class="mx-ditrina">{{ site.wordmark.second }}</span></span
>
